# OPTIONAL low-latency trigger (spec 06 §5): react to a capture landing
# instead of waiting up to 10 minutes for the timer. Enable it only if you
# want captures processed within seconds; the timer alone is sufficient.
#
# CAUTION — MakeDirectory=true creates the watched paths if they are absent.
# On a machine where the vault is a network/removable mount that has not
# come up yet, that means systemd creates an EMPTY ~/notes/capture/raw_capture
# and the pipeline then scans nothing. That is survivable by design: spec
# 06 §1 forbids purging emission history when a configured scan dir is
# missing or empty (08 §B5), so a transient mount cannot make the store
# forget a year of checkpoints. It is still worth knowing before you see an
# empty directory appear and wonder who made it.

[Unit]
Description=organize — watch the vault for new captures and notes
# README's own rule: OnFailure= on EVERY unit that can fail. A .path unit
# can fail at START — MakeDirectory=true on a %h/notes that is a dangling
# symlink while the vault is unmounted is the realistic case — and without
# this the low-latency trigger sits in `failed` with nobody told. That is a
# quieter instance of exactly the silent-death class this directory exists
# to prevent. The alerter is templated on %n, so it needs no other change.
OnFailure=organize-pipeline-failure@%n.service

[Path]
Unit=organize-pipeline.service
# ~/notes is the symlink to ~/Obsidian/Main (spec 02: the two resolve equal).
PathChanged=%h/notes/capture/raw_capture
PathChanged=%h/notes/resources
MakeDirectory=true

[Install]
WantedBy=paths.target
